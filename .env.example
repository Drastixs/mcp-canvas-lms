# Canvas API Configuration
# CANVAS_API_TOKEN is optional if you use the built-in OAuth authentication.
# Run the canvas_authenticate tool to set up authentication automatically.
# Or generate a token manually at https://your_domain/profile/settings > Access Tokens.
# CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_DOMAIN=your_domain.instructure.com

# OAuth Authentication Credentials (used by canvas_authenticate tool)
# Set these so you don't have to type your credentials in the Claude prompt.
CANVAS_EMAIL=your_email@university.ac.uk
CANVAS_PASSWORD=your_password_here

# Optional: Advanced Configuration
NODE_ENV=development
LOG_LEVEL=info
CANVAS_MAX_RETRIES=3
CANVAS_RETRY_DELAY=1000
CANVAS_TIMEOUT=30000

# Optional: Transport Configuration
# MCP_TRANSPORT: stdio (default) or streamable-http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_HTTP_STATEFUL=true
MCP_HTTP_JSON_RESPONSE=true
# Comma-separated allowlist. Empty disables Origin checks.
MCP_HTTP_ALLOWED_ORIGINS=

# Optional: Test Configuration
CANVAS_TEST_TOKEN=your_test_token_here
CANVAS_TEST_DOMAIN=test.instructure.com
